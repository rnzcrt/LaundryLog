{
  "name": "laundrylog",
  "version": "0.1.0",
  "description": "Laundry shop management: orders, customers, machines, inventory, payments and reporting.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/run-migrations.js",
    "seed": "node db/run-seed.js",
    "setup": "npm run migrate && npm run seed",
    "check": "node scripts/check.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "license": "MIT"
}
